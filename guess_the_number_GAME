#include<stdio.h>
void main(){
	
	int guess_num,user_num,count = 0;
	srand(time(0));
	guess_num = rand(guess_num);
	
	printf("\n\n\t\t\t\t\t\t----WELCOME TO THE PSEUDO RANDOM NUMBER GENERATOR GAME-----\n\n");

	while(1)	
	{
		printf("Guess the number!!\n");
		scanf("%d",&user_num);
		count++;
		
		if(user_num == guess_num){
			printf("You guessed the correct Number!!");
			break;	}
		else if(user_num > guess_num)
			printf("Enter a lower number!!\n");
		else if(user_num < guess_num)
			printf("Enter a higher number!!\n");
	}
	
	printf("\nYour Total score is : %d",count);
	
}
